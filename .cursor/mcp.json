{
  "mcpServers": {
    "uxcore": {
      "command": "npx",
      "args": [
        "aichemy",
        "mcp",
        "@ux/uxcore2-codex",
        "--registry",
        "https://gdartifactory1.jfrog.io/artifactory/api/npm/node-virt/"
      ]
    },
    "boilerplate": {
      "command": "npx",
      "args": ["-y", "github:gdcorp-engineering/boilerplate-infra", "mcp"],
      "env": {
        "THEME_NAME": "godaddy-antares",
        "THEME_OUTPUT_DIR": "./src/themes/theme.css"
      }
    }
  }
}
